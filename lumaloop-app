"""
A small status window for lumaloop.service.

The pipeline itself is `lumaloop`, running as a user systemd unit. This window
is only a face on it, and does three things:

  - starts / stops the unit. Start always does reset-failed first: a boot with
    the camera unplugged burns StartLimitBurst and leaves the unit stuck in
    'failed', where Restart=always never fires again. Clicking Start should
    just work, whatever state it was left in.

  - follows the unit's journal and turns the metering lines into words. The
    pipeline already says everything worth knowing, in its own terms
    ("p70 138 p99 174 exposure 313 -> 306 (above target)"); the window only
    translates.

  - shows the snapshot the pipeline writes. Once a video app is on the virtual
    camera nothing else can stream it, so that snapshot is the only way to see
    what the pipeline is actually producing.

  - sets the target brightness. The slider writes a one-line file the running
    pipeline re-reads every second, so it applies live, mid-call, and sticks
    across restarts. Reset removes the file and hands control back to config.

Reads the same config file as the pipeline, for the snapshot path and the
configured target.
"""
import os
import re
import subprocess
import time

from PySide6.QtCore import Qt, QFileSystemWatcher, QProcess, QRectF, QTimer
from PySide6.QtGui import QColor, QFont, QIcon, QPainter, QPalette, QPen, QPixmap
from PySide6.QtWidgets import (QApplication, QHBoxLayout, QLabel, QPushButton,
                               QSizePolicy, QSlider, QVBoxLayout, QWidget)

try:
    import tomllib                     # Python 3.11+
except ModuleNotFoundError:
    tomllib = None

UNIT = "lumaloop.service"

_CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
_CACHE_HOME  = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
CONFIG_PATH  = os.path.join(_CONFIG_HOME, "lumaloop", "config.toml")


def _configured(key, fallback):
    """One value out of the pipeline's config, whatever table it sits in.

    The window has to agree with the pipeline about where the snapshot is
    written, and the pipeline's config is the single place that says so.
    """
    if tomllib is None or not os.path.exists(CONFIG_PATH):
        return fallback
    try:
        with open(CONFIG_PATH, "rb") as fh:
            raw = tomllib.load(fh)
    except (OSError, tomllib.TOMLDecodeError):
        return fallback
    for section in [raw] + [v for v in raw.values() if isinstance(v, dict)]:
        if key in section:
            return section[key]
    return fallback


SNAPSHOT = os.path.expanduser(
    _configured("snapshot", os.path.join(_CACHE_HOME, "lumaloop", "snap.jpg")))
VCAM_LABEL = _configured("vcam_name", "") or "the virtual camera"

# Must match TARGET_PATH and the clamp in `lumaloop`.
_STATE_HOME   = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
TARGET_PATH   = os.path.join(_STATE_HOME, "lumaloop", "target")
CONFIG_TARGET = int(_configured("target", 132))
TARGET_LO, TARGET_HI = 40, 220
TARGET_SAVE_MS = 300   # debounce: a slider drag is dozens of values

# The metering box, drawn on the preview. The snapshot is the full uncropped
# frame, so the pipeline's frame fractions map straight onto it.
BOX      = tuple(float(v) for v in _configured("box", (0.25, 0.75, 0.10, 1.00)))
HIGH_MAX = int(_configured("high_max", 235))
PREVIEW_W   = 384
PREVIEW_H   = 216
SNAP_STALE  = 25     # seconds before a snapshot counts as "not arriving"
POLL_MS     = 2000   # how often the unit's state is checked
PREVIEW_MS  = 400    # backstop poll; inotify does the real work
CLOCK_MS    = 100    # how often the "last frame" stopwatch is redrawn

# Colours for the state dot. Kept literal rather than themed: green/amber/red
# have to mean the same thing in a light and a dark palette.
OK, BUSY, BAD, OFF = "#2ec27e", "#e5a50a", "#e01b24", "#9a9996"

# "  p70 132 p99 174  exposure 313  gain 0   (in band)"
# "  p70 138 p99 174  exposure 313 -> 306      (above target)"
METER = re.compile(
    r"p(?P<pc>\d+)\s+(?P<lvl>\d+)\s+"
    r"p(?P<hpc>\d+)\s+(?P<high>\d+)(?P<mark>[*\s])\s+"
    r"(?P<what>.*?)\s+\((?P<why>[^)]+)\)\s*$")
# Each line names only the knob that just moved ("gain 20 -> 22"), so the
# two are tracked separately and each keeps its last known value.
KNOB = {n: re.compile(rf"{n}\s+(\d+)(?:\s*->\s*(\d+))?")
        for n in ("exposure", "gain")}

# The pipeline's own words -> what is actually happening, for someone who
# just wants to know whether they look right on the call.
BRIGHTNESS = {
    "in band":      ("on target",                  OK),
    "above target": ("a little bright, correcting", BUSY),
    "below target": ("a little dark, correcting",   BUSY),
    "over ceiling": ("pulling back for highlights", BUSY),
    "saturated":    ("blown out, pulling back",     BAD),
}


def dimmed(widget, fraction=0.58):
    """A muted version of the theme's own text colour.

    NOT palette(mid): that is a frame-shading role, and on a dark theme it
    lands within a few points of the window background - the label renders,
    reserves its space, and is simply invisible. Blending foreground toward
    background works in both light and dark schemes.
    """
    pal = widget.palette()
    fg = pal.color(QPalette.WindowText)
    bg = pal.color(QPalette.Window)
    f = fraction
    return QColor(
        round(fg.red()   * f + bg.red()   * (1 - f)),
        round(fg.green() * f + bg.green() * (1 - f)),
        round(fg.blue()  * f + bg.blue()  * (1 - f))).name()


def systemctl(*args, capture=True):
    return subprocess.run(("systemctl", "--user") + args,
                          capture_output=capture, text=True)


class Row(QWidget):
    """One 'label  value' line in the readout."""

    def __init__(self, name):
        super().__init__()
        lay = QHBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        key = QLabel(name)
        key.setFixedWidth(96)
        key.setStyleSheet(f"color: {dimmed(key)};")
        self.value = QLabel("--")
        lay.addWidget(key)
        lay.addWidget(self.value, 1)

    def set(self, text, colour=None):
        self.value.setText(text)
        self.value.setStyleSheet(f"color: {colour};" if colour else "")


class CameraWindow(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("lumaloop")
        self.setWindowIcon(QIcon.fromTheme("camera-web"))
        self.active = False          # unit state, from systemctl
        self.meter = None            # last parsed metering line
        self.knobs = {}               # last known exposure / gain
        self.note = None             # last non-metering line worth showing
        self.journal = None

        root = QVBoxLayout(self)
        root.setContentsMargins(18, 18, 18, 18)
        root.setSpacing(14)

        self.preview = QLabel()
        self.preview.setFixedSize(PREVIEW_W, PREVIEW_H)
        self.preview.setAlignment(Qt.AlignCenter)
        self.preview.setStyleSheet(
            "background: #1b1b1b; border-radius: 6px; color: #777;")
        self.preview.setToolTip(
            "The dashed box is where brightness is measured.\n"
            "subject: the 70th-percentile level in the box, held near the target.\n"
            "bright: the 99th-percentile level, kept under the ceiling so\n"
            "highlights do not clip. Levels are 0-255.")
        root.addWidget(self.preview, 0, Qt.AlignHCenter)

        # The picture alone cannot show whether it is live: a still room looks
        # identical frozen or updating. This line is the proof - it counts up
        # between frames and resets each time the file on disk changes.
        self.snapinfo = QLabel()
        self.snapinfo.setAlignment(Qt.AlignCenter)
        mono = QFont("monospace")
        mono.setStyleHint(QFont.Monospace)
        mono.setPointSizeF(self.font().pointSizeF() - 0.5)
        self.snapinfo.setFont(mono)
        self.snapinfo.setStyleSheet(f"color: {dimmed(self.snapinfo)};")
        root.addWidget(self.snapinfo)

        self.state = QLabel()
        f = QFont(self.font())
        f.setPointSizeF(f.pointSizeF() + 1.5)
        f.setBold(True)
        self.state.setFont(f)
        root.addWidget(self.state)

        self.rows = {n: Row(n) for n in
                     ("Brightness", "Highlights", "Exposure", "Gain")}
        for row in self.rows.values():
            root.addWidget(row)
        # Gain is only interesting once the camera runs out of exposure and
        # starts trading noise for brightness, so it stays hidden at 0.
        self.rows["Gain"].hide()

        self.build_target_row(root)

        self.hint = QLabel()
        self.hint.setWordWrap(True)
        self.hint.setStyleSheet(f"color: {dimmed(self.hint)};")
        root.addWidget(self.hint)

        root.addStretch(1)

        self.button = QPushButton()
        self.button.setMinimumHeight(38)
        self.button.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        self.button.clicked.connect(self.toggle)
        root.addWidget(self.button)

        self.snap_mtime = 0
        self.snap_interval = None    # measured gap between the last two frames
        self.snap_count = 0          # frames that actually changed on disk

        self.poll()
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.poll)
        self.timer.start(POLL_MS)

        # The preview gets its own, faster timer. Polling the unit is a fork
        # per tick and does not need to be quick; noticing a new snapshot is
        # one stat() and wants to be. Sharing one 2s timer also beat the
        # snapshot's own cadence, so a new frame surfaced 4-6s late.
        # inotify, so the stopwatch resets the moment ffmpeg writes the file
        # rather than up to PREVIEW_MS later - that lag was why the counter
        # visibly ran past 5.0s before flipping, every single cycle.
        self.watcher = QFileSystemWatcher(self)
        self.watcher.fileChanged.connect(self.poll_snapshot)
        self.watch_file()

        # The timer stays as a backstop: QFileSystemWatcher drops its watch
        # when a file is replaced rather than modified in place, and ffmpeg's
        # -update 1 can do either depending on how the muxer flushes.
        self.snap_timer = QTimer(self)
        self.snap_timer.timeout.connect(self.poll_snapshot)
        self.snap_timer.start(PREVIEW_MS)

        self.clock = QTimer(self)
        self.clock.timeout.connect(self.tick)
        self.clock.start(CLOCK_MS)
        self.tick()

    # -- the target -------------------------------------------------------

    def build_target_row(self, root):
        lay = QHBoxLayout()
        lay.setContentsMargins(0, 0, 0, 0)
        key = QLabel("Target")
        key.setFixedWidth(96)
        key.setStyleSheet(f"color: {dimmed(key)};")

        self.slider = QSlider(Qt.Horizontal)
        self.slider.setRange(TARGET_LO, TARGET_HI)
        self.slider.setPageStep(10)
        self.slider.setToolTip(
            "How bright the camera keeps you, as a 0-255 level.\n"
            "Higher is brighter. Applies within a couple of seconds,\n"
            "with no restart, and is remembered.")

        self.target_label = QLabel()
        self.target_label.setFixedWidth(28)
        self.target_label.setAlignment(Qt.AlignRight | Qt.AlignVCenter)

        self.reset = QPushButton("Reset")
        self.reset.setToolTip(f"Back to the configured target ({CONFIG_TARGET})")
        self.reset.clicked.connect(lambda: self.slider.setValue(CONFIG_TARGET))

        lay.addWidget(key)
        lay.addWidget(self.slider, 1)
        lay.addWidget(self.target_label)
        lay.addWidget(self.reset)
        root.addLayout(lay)

        self.save_timer = QTimer(self)
        self.save_timer.setSingleShot(True)
        self.save_timer.setInterval(TARGET_SAVE_MS)
        self.save_timer.timeout.connect(self.save_target)

        self.slider.setValue(self.load_target())
        self.show_target(self.slider.value())
        self.slider.valueChanged.connect(self.target_moved)

    @staticmethod
    def load_target():
        """What the pipeline will use: the saved override, else the config."""
        try:
            with open(TARGET_PATH) as fh:
                value = int(fh.read().strip())
        except (OSError, ValueError):
            return CONFIG_TARGET
        return max(TARGET_LO, min(TARGET_HI, value))

    def show_target(self, value):
        self.target_label.setText(str(value))
        self.reset.setEnabled(value != CONFIG_TARGET)
        if self.active:
            self.draw_preview()      # the overlay names the target

    def target_moved(self, value):
        self.show_target(value)
        self.save_timer.start()

    def save_target(self):
        """Write atomically, so the pipeline never reads half a number.

        Landing back on the configured value removes the file instead, so a
        later edit to config.toml is not silently shadowed by a stale override.
        """
        value = self.slider.value()
        try:
            if value == CONFIG_TARGET:
                if os.path.exists(TARGET_PATH):
                    os.remove(TARGET_PATH)
                return
            os.makedirs(os.path.dirname(TARGET_PATH), exist_ok=True)
            tmp = TARGET_PATH + ".tmp"
            with open(tmp, "w") as fh:
                fh.write(f"{value}\n")
            os.replace(tmp, TARGET_PATH)
        except OSError as e:
            self.note = f"Could not save the target: {e.strerror}"
            self.refresh()

    # -- the unit ---------------------------------------------------------

    def toggle(self):
        if self.active:
            systemctl("stop", UNIT)
            self.meter = self.note = None
            self.knobs = {}
        else:
            # Always clear the failed state first - see the module docstring.
            systemctl("reset-failed", UNIT)
            systemctl("start", UNIT)
            self.state.setText("Starting...")
            self.state.setStyleSheet(f"color: {BUSY};")
        QTimer.singleShot(400, self.poll)

    def poll(self):
        was = self.active
        self.active = systemctl("is-active", UNIT).stdout.strip() == "active"
        if self.active and not was:
            self.start_journal()
        elif was and not self.active:
            self.stop_journal()
            self.meter = None
            self.knobs = {}
            self.snap_mtime = 0
            self.snap_interval = None
            self.snap_count = 0
        self.refresh()

    def watch_file(self):
        """(Re-)arm the inotify watch if the file exists and is unwatched."""
        if os.path.exists(SNAPSHOT) and SNAPSHOT not in self.watcher.files():
            self.watcher.addPath(SNAPSHOT)

    def poll_snapshot(self, *_):
        """Redraw only when the file on disk has actually changed."""
        self.watch_file()
        if not self.active:
            return
        try:
            mtime = os.path.getmtime(SNAPSHOT)
        except OSError:
            return
        if mtime != self.snap_mtime:
            if self.snap_mtime:
                self.snap_interval = mtime - self.snap_mtime
            self.snap_mtime = mtime
            self.snap_count += 1
            self.draw_preview()
            self.tick()
        elif self.stale(mtime):
            self.draw_preview()      # keep the "not updating" veil honest

    def tick(self):
        """Redraw the stopwatch under the preview."""
        if not self.active or not self.snap_mtime:
            self.snapinfo.setText("")
            return
        age = time.time() - self.snap_mtime
        every = f"every {self.snap_interval:.1f}s" if self.snap_interval else "measuring"
        self.snapinfo.setText(
            f"last frame {age:4.1f}s ago  \u00b7  {every}  \u00b7  "
            f"{self.snap_count} frame{'' if self.snap_count == 1 else 's'}")

    # -- the journal ------------------------------------------------------

    def start_journal(self):
        self.stop_journal()
        self.journal = QProcess(self)
        self.journal.setProcessChannelMode(QProcess.MergedChannels)
        self.journal.readyReadStandardOutput.connect(self.read_journal)
        # -n 40 so an already-running pipeline fills the window immediately
        # instead of staying blank until the next correction.
        self.journal.start("journalctl", ["--user", "-u", UNIT,
                                          "-f", "-n", "40", "-o", "cat"])

    def stop_journal(self):
        if self.journal:
            self.journal.kill()
            self.journal.waitForFinished(500)
            self.journal = None

    def read_journal(self):
        data = bytes(self.journal.readAllStandardOutput()).decode(errors="replace")
        for line in data.splitlines():
            line = line.strip()
            if not line:
                continue
            m = METER.search(line)
            if m:
                self.meter = m
                self.note = None
                for name, pattern in KNOB.items():
                    k = pattern.search(m["what"])
                    if k:
                        self.knobs[name] = int(k.group(2) or k.group(1))
            elif "not found" in line:
                self.note = "Camera not found - is it plugged in?"
            elif "waiting for metering frames" in line:
                self.note = "Waiting for the first frames..."
            elif "ffmpeg died" in line:
                self.note = "Video pipeline restarting..."
            elif "camera drifted" in line:
                self.note = "Camera drifted - re-adopting its settings"
        self.refresh()

    # -- drawing ----------------------------------------------------------

    def refresh(self):
        self.button.setText("Stop camera" if self.active else "Start camera")

        if not self.active:
            self.state.setText("Stopped")
            self.state.setStyleSheet(f"color: {OFF};")
            self.hint.setText("Start the camera before joining a call.")
            for row in self.rows.values():
                row.set("--")
            self.draw_preview(off=True)
            return

        self.hint.setText(f"Pick {VCAM_LABEL} as your camera in your video app.")
        self.draw_preview()

        if self.note:
            self.state.setText(self.note)
            self.state.setStyleSheet(f"color: {BUSY};")
            return
        if not self.meter:
            self.state.setText("Starting...")
            self.state.setStyleSheet(f"color: {BUSY};")
            return

        why = self.meter["why"]
        limited = "AT LIMIT" in why
        word, colour = BRIGHTNESS.get(why.split(" - ")[0], ("adjusting", BUSY))
        if limited:
            word += " (as far as it can)"
            colour = BAD

        self.state.setText("Running - feeding the virtual camera")
        self.state.setStyleSheet(f"color: {OK};")
        self.rows["Brightness"].set(word, colour)

        high = int(self.meter["high"])
        if high >= 250:
            self.rows["Highlights"].set("clipping", BAD)
        elif high >= 230:
            self.rows["Highlights"].set("close to clipping", BUSY)
        else:
            self.rows["Highlights"].set("not clipping", OK)

        self.rows["Exposure"].set(str(self.knobs.get("exposure", "--")))
        gain = self.knobs.get("gain")
        self.rows["Gain"].setVisible(bool(gain))
        if gain:
            self.rows["Gain"].set(f"{gain} (brightening a dark room)", BUSY)

    def draw_preview(self, off=False):
        if off or not os.path.exists(SNAPSHOT):
            self.preview.setPixmap(QPixmap())
            self.preview.setText("Camera off" if off else "No picture yet")
            return

        age = os.path.getmtime(SNAPSHOT)
        pix = QPixmap(SNAPSHOT)
        if pix.isNull():
            # Half-written file: keep whatever is on screen and come back.
            if self.preview.pixmap().isNull():
                self.preview.setText("No picture yet")
            QTimer.singleShot(60, self.draw_preview)
            return
        pix = pix.scaled(PREVIEW_W, PREVIEW_H,
                         Qt.KeepAspectRatio, Qt.SmoothTransformation)
        self.draw_metering(pix)

        # A snapshot that has stopped updating means the pipeline is stalled,
        # not that the picture is fine. Say so on the picture itself.
        if self.stale(age):
            painter = QPainter(pix)
            painter.fillRect(pix.rect(), QColor(0, 0, 0, 140))
            painter.setPen(QColor("#ffffff"))
            painter.drawText(pix.rect(), Qt.AlignCenter, "picture not updating")
            painter.end()

        self.preview.setText("")
        self.preview.setPixmap(pix)

    def draw_metering(self, pix):
        """Outline the metering box and print what was measured inside it.

        The numbers come from the last metering line in the journal. The
        pipeline logs on every correction but only every 30s while holding,
        so a settled picture can show readings up to that old - they are
        still what the loop is acting on.
        """
        w, h = pix.width(), pix.height()
        x0, x1, y0, y1 = BOX
        box = QRectF(x0 * w, y0 * h, (x1 - x0) * w, (y1 - y0) * h).adjusted(1, 1, -1, -1)

        painter = QPainter(pix)
        painter.setRenderHint(QPainter.Antialiasing)
        # Dark under white, so the outline reads on a white wall and a black
        # shirt alike.
        painter.setPen(QPen(QColor(0, 0, 0, 150), 3))
        painter.drawRect(box)
        painter.setPen(QPen(QColor(255, 255, 255, 220), 1.5, Qt.DashLine))
        painter.drawRect(box)

        target = self.slider.value()
        if self.meter:
            m = self.meter
            lines = [f"subject {m['lvl']:>3} / target  {target}",
                     f"bright  {m['high']:>3} / ceiling {HIGH_MAX}"]
        else:
            lines = [f"measuring...  target {target}"]

        font = QFont("monospace")
        font.setStyleHint(QFont.Monospace)
        font.setPixelSize(10)
        painter.setFont(font)
        fm = painter.fontMetrics()
        pad = 4
        tw = max(fm.horizontalAdvance(t) for t in lines) + 2 * pad
        th = fm.height() * len(lines) + 2 * pad
        # Inside the box when it fits; never off the picture.
        label = QRectF(min(box.left() + 4, w - tw - 2), box.top() + 4, tw, th)
        painter.setPen(Qt.NoPen)
        painter.setBrush(QColor(0, 0, 0, 160))
        painter.drawRoundedRect(label, 3, 3)
        painter.setPen(QColor("#ffffff"))
        for i, text in enumerate(lines):
            painter.drawText(QRectF(label.left() + pad,
                                    label.top() + pad + i * fm.height(),
                                    tw, fm.height()),
                             Qt.AlignLeft | Qt.AlignVCenter, text)
        painter.end()

    @staticmethod
    def stale(mtime):
        return time.time() - mtime > SNAP_STALE

    def closeEvent(self, event):
        if self.save_timer.isActive():   # a drag released just before closing
            self.save_timer.stop()
            self.save_target()
        self.stop_journal()
        super().closeEvent(event)


def main():
    app = QApplication([])
    app.setApplicationName("lumaloop")
    app.setDesktopFileName("lumaloop")
    win = CameraWindow()
    win.show()
    app.exec()


if __name__ == "__main__":
    main()
